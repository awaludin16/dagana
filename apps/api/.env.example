APP_NAME=Dagana
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

# ─── Dagana JWT ────────────────────────────────────────────────────
# generate: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
JWT_TTL=900              # access token (detik) = 15 menit
REFRESH_TTL=2592000      # refresh token (detik) = 30 hari

# ─── Logging ───────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database (default PostgreSQL) ─────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dagana
DB_USERNAME=dagana
DB_PASSWORD=secret

# Untuk tes lokal tanpa PostgreSQL, bisa komentar pgsql di atas & pakai:
# DB_CONNECTION=sqlite
# DB_DATABASE=

# ─── Session ───────────────────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ─── Broadcast / Queue / Cache ────────────────────────────────────
BROADCAST_CONNECTION=redis
FILESYSTEM_DISK=local
# Default dev lokal: tanpa Redis (cache file, queue sync). Setel ulang ke
# `redis` bila menjalankan stack lengkap Docker (infra/docker/compose.yaml).
QUEUE_CONNECTION=sync
CACHE_STORE=file

# ─── Laravel Reverb (WebSocket, Phase 3/4 realtime) ────────────────
# generate app key & secret: php -r "echo 'base64:'.base64_encode(random_bytes(32));"
REVERB_APP_ID=dagana
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8081

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ─── Mail ──────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@dagana.test
MAIL_FROM_NAME=${APP_NAME}

# ─── Services ──────────────────────────────────────────────────────
VITE_APP_NAME=${APP_NAME}