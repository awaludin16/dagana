{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Dagana Design Tokens",
  "version": "1.0.0",
  "description": "Shared visual tokens for Dagana React Web and Flutter POS.",
  "color": {
    "brand": {
      "primary": "#176B52",
      "primaryHover": "#12543F",
      "primarySoft": "#DCEFE7",
      "amber": "#E8A23A",
      "amberForeground": "#2D2417",
      "terracotta": "#A94F36",
      "terracottaForeground": "#FFFFFF"
    },
    "light": {
      "background": "#F6F8F5",
      "surface": "#FFFFFF",
      "surfaceSubtle": "#EDF2EE",
      "text": "#18231E",
      "textMuted": "#5D6B63",
      "border": "#E3E8E4",
      "inputBorder": "#D5DED8",
      "focus": "#176B52",
      "primary": "#176B52",
      "onPrimary": "#FFFFFF",
      "primaryContainer": "#DCEFE7",
      "onPrimaryContainer": "#123B2D",
      "secondary": "#E8A23A",
      "onSecondary": "#2D2417",
      "tertiary": "#A94F36",
      "onTertiary": "#FFFFFF",
      "success": "#18794E",
      "successContainer": "#E1F3E8",
      "warning": "#A15C00",
      "warningContainer": "#FFF1D6",
      "danger": "#B42318",
      "dangerContainer": "#FCE8E6",
      "info": "#245E9B",
      "infoContainer": "#E7F0FA"
    },
    "dark": {
      "background": "#101A16",
      "surface": "#17231D",
      "surfaceRaised": "#1E2D25",
      "surfaceSubtle": "#25372D",
      "text": "#F2F6F3",
      "textMuted": "#B2C0B7",
      "border": "#34463B",
      "focus": "#77CBAA",
      "primary": "#77CBAA",
      "onPrimary": "#0C2D20",
      "primaryContainer": "#204C3B",
      "onPrimaryContainer": "#D9F3E7",
      "secondary": "#F1B756",
      "onSecondary": "#30200A",
      "tertiary": "#F0A087",
      "onTertiary": "#30150E",
      "success": "#63D5A2",
      "successContainer": "#153C2B",
      "onSuccessContainer": "#A7E9C7",
      "warning": "#F1B756",
      "warningContainer": "#49310F",
      "onWarningContainer": "#FFD48B",
      "danger": "#FF8A80",
      "dangerContainer": "#4A1E1B",
      "onDangerContainer": "#FFC4BC",
      "info": "#80B8F0",
      "infoContainer": "#18334D",
      "onInfoContainer": "#B9D9FF"
    }
  },
  "typography": {
    "family": "Plus Jakarta Sans",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semiBold": 600,
      "bold": 700,
      "extraBold": 800
    },
    "scale": {
      "display": { "web": 36, "mobile": 32, "lineHeight": 1.22, "weight": 700 },
      "pageTitle": { "web": 28, "mobile": 24, "lineHeight": 1.29, "weight": 700 },
      "sectionTitle": { "web": 20, "mobile": 18, "lineHeight": 1.4, "weight": 600 },
      "cardTitle": { "web": 16, "mobile": 16, "lineHeight": 1.5, "weight": 600 },
      "body": { "web": 14, "mobile": 14, "lineHeight": 1.57, "weight": 400 },
      "bodyLarge": { "web": 16, "mobile": 16, "lineHeight": 1.5, "weight": 400 },
      "label": { "web": 13, "mobile": 14, "lineHeight": 1.54, "weight": 600 },
      "caption": { "web": 12, "mobile": 12, "lineHeight": 1.5, "weight": 500 }
    },
    "numeric": { "web": "tabular-nums", "flutter": "FontFeature.tabularFigures()" }
  },
  "spacingPx": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64 },
  "radiusPx": { "control": 8, "card": 12, "dialog": 16, "pill": 999 },
  "touchTarget": { "webMinPx": 44, "flutterMinLogicalPx": 48 },
  "breakpointsPx": { "sm": 640, "md": 768, "lg": 1024, "xl": 1280, "2xl": 1536 }
}
