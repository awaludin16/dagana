# Development-only overrides for compose.yaml. Copy to `.env` (git-ignored).
# These credentials are disposable and must never be reused outside local dev.
POSTGRES_DB=dagana
POSTGRES_USER=dagana
POSTGRES_PASSWORD=dagana_dev
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
# Optional: replace with `php artisan key:generate --show` output.
# APP_KEY=base64:...
